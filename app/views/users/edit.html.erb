<div class="cover-user-edit">
  <div class="container d-flex flex-column align-items-center">
    <div class="row mt-5">
      <h1 class="fw-normal">プロフィール編集</h1>
    </div>
    <div class="row mt-5">
      <%= form_with model: @user, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">名前</label>
          <%= f.text_field :name, autofocus: true, id: "inputName", placeholder: "名前", class: "form-control" %>
        </div>
        <div class="mb-3">
          <label class="form-label">プロフィール画像</label><br>
          <% if @user.profile_image.attached? %>
            <%= image_tag @user.profile_image, size: '100x100', class: "mb-3 profile-img" %><br>
          <% else %>
            <%= image_tag "no_image.svg", size: '100x100', class: "mb-3 profile-img" %><br>
          <% end %>
          <%= f.file_field :profile_image %>
        </div>
        <div class="mb-3">
          <label class="form-label">プロフィール</label>
          <%= f.text_field :profile, class: "form-control" %>
        </div>
        <%= f.submit '保存する', class: "btn btn-success" %>
      <% end %>
    </div>
  </div>
</div>